#!/bin/bash
set -euo pipefail

# Check that at least one argument is given
if [ "$#" -lt 1 ]; then
    echo "Usage: $0 <dir1> [dir2] ... [dirN]" >&2
    exit 1
fi

echo "=== QuantumTech Log Collector Run: $(date) ==="

for target_dir in "$@"; do
    echo "----------------------------------------"
    echo "Scanning Target: ${target_dir}"
    echo "----------------------------------------"
    
    # Validation 1: Check if path exists
    if [ ! -e "${target_dir}" ]; then
        echo "[WARNING] Path does not exist: ${target_dir}. Skipping safely."
        continue
    fi
    
    # Validation 2: Check if path is an accessible directory
    if [ ! -d "${target_dir}" ] || [ ! -r "${target_dir}" ]; then
        echo "[WARNING] Directory unreadable or inaccessible: ${target_dir}. Skipping safely."
        continue
    fi
    
    # Traversal loop: safely list file information
    find "${target_dir}" -maxdepth 2 -type f 2>/dev/null | while read -r target_file; do
        if [ -r "${target_file}" ]; then
            file_size=$(stat -c %s "${target_file}")
            file_owner=$(stat -c %U "${target_file}")
            echo "[FILE] ${target_file} (${file_size} bytes, owner: ${file_owner})"
        else
            echo "[SKIPPED] ${target_file} (Permission Denied)"
        fi
    done
done

echo "=== Scan Task Completed Successfully ==="
